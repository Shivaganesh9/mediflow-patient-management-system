{
  "name": "mediflow-ui",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "tsc -b && vite build",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:demo": "playwright test --project=demo",
    "test:e2e:report": "playwright show-report e2e/report",
    "test:e2e:install": "playwright install chromium",
    "typecheck:e2e": "tsc -p e2e/tsconfig.json"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.1",
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.5",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
