# ============================================================================
# MediFlow production environment (single Linux VM, Docker Compose)
#
# Copy this file to .env.prod on the server, replace every value, then:
#   chmod 600 .env.prod
#
#   docker compose --env-file .env.prod \
#     -f docker-compose.yml -f docker-compose.prod.yml up -d
#
# .env.prod is git-ignored. Never commit real secrets and never reuse the
# development .env values. Services refuse to start if JWT_SECRET or
# DB_PASSWORD is missing.
# ============================================================================

# Image tag built on the workstation/CI (`mvn -DskipTests package` + `docker build`).
MEDIFLOW_IMAGE_TAG=1.0.0

# ---------------------------------------------------------------- PostgreSQL
# One superuser role owns the eight per-service databases created on first boot.
# Generate with: openssl rand -base64 32
POSTGRES_USER=mediflow
POSTGRES_PASSWORD=replace-with-a-long-random-password

# ---------------------------------------------------------------- JWT
# HS256 signing key shared by every service. Must be at least 32 bytes of
# random data; auth-service refuses to start with a shorter key.
# Generate with: openssl rand -base64 48
JWT_SECRET=replace-with-at-least-32-random-bytes

# ---------------------------------------------------------------- Edge / browser
# Public origin used by the browser. Keep it exactly the URL served by nginx
# (scheme + host, no trailing slash).
CORS_ALLOWED_ORIGINS=https://mediflow.example.com

# Optional: publish the edge on non-standard host ports (defaults 80/443).
# WEB_HTTP_PORT=80
# WEB_HTTPS_PORT=443

# ---------------------------------------------------------------- Clinic time
# Same value for appointment-service and medical-record-service. Naive clinic
# timestamps are interpreted in this zone; the container images ship with the
# Asia/Kolkata JVM zone, so keep them aligned unless you also change the images.
CLINIC_TIME_ZONE=Asia/Kolkata

# Do not add SPRING_PROFILES_ACTIVE here: production must never load a
# dev/seed profile.
