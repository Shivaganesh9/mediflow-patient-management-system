SPRING_PROFILES_ACTIVE=dev
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me
DB_USERNAME=postgres
DB_PASSWORD=change-me
EUREKA_URL=http://localhost:8761/eureka/
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
SERVER_PORT=8080
CORS_ALLOWED_ORIGINS=http://localhost:3000
AUTH_SERVICE_URL=http://localhost:8081
PATIENT_SERVICE_URL=http://localhost:8083
APPOINTMENT_SERVICE_URL=http://localhost:8084
DOCTOR_SERVICE_URL=http://localhost:8085
MEDICAL_RECORD_SERVICE_URL=http://localhost:8091
BILLING_SERVICE_URL=http://localhost:8087
NOTIFICATION_SERVICE_URL=http://localhost:8089
ANALYTICS_SERVICE_URL=http://localhost:8088
# Generate a long random dev-only secret, e.g. `openssl rand -base64 48`
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRATION=900000
JWT_REFRESH_EXPIRATION=604800000

# Shared access-token revocation (Redis). All services must point at the same Redis.
REDIS_HOST=localhost
REDIS_PORT=6379
SECURITY_REVOCATION_ENABLED=true
SECURITY_REVOCATION_FAIL_OPEN=false
SECURITY_REVOCATION_KEY_PREFIX=mediflow:revoke:
SECURITY_REVOCATION_MARKER_TTL=7d

# Login throttling and account lifecycle (auth-service).
SECURITY_LOGIN_MAX_FAILED_ATTEMPTS=5
SECURITY_LOGIN_LOCKOUT_DURATION=15m
AUTH_REFRESH_REUSE_GRACE=10s
AUTH_PASSWORD_RESET_TOKEN_TTL=30m
# Local/dev only: return the reset token in the API response (no mail delivery exists).
AUTH_PASSWORD_RESET_EXPOSE_TOKEN=false

# Database pool and query limits (all services).
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_POOL_CONNECTION_TIMEOUT_MS=3000
DB_LEAK_DETECTION_MS=20000
JPA_SHOW_SQL=false
MAX_PAGE_SIZE=100

# Kafka producer/consumer bounds.
KAFKA_DELIVERY_TIMEOUT_MS=20000
KAFKA_REQUEST_TIMEOUT_MS=10000
KAFKA_MAX_BLOCK_MS=5000
KAFKA_MAX_POLL_RECORDS=100
KAFKA_CONSUMER_CONCURRENCY=1

# Transactional outbox relay (appointment, billing, medical-record).
OUTBOX_PUBLISHER_ENABLED=true
OUTBOX_PUBLISHER_INTERVAL_MS=1000
OUTBOX_PUBLISHER_INITIAL_DELAY_MS=5000
OUTBOX_PUBLISHER_BATCH_SIZE=20
OUTBOX_PUBLISHER_MAX_ATTEMPTS=10
OUTBOX_PUBLISHER_SEND_TIMEOUT_MS=5000

# Gateway upstream HTTP client.
GATEWAY_CONNECT_TIMEOUT_MS=2000
GATEWAY_RESPONSE_TIMEOUT=10s
GATEWAY_POOL_MAX_CONNECTIONS=200
GATEWAY_POOL_ACQUIRE_TIMEOUT_MS=5000

# Health detail visibility: never (default) or when-authorized/always for local debugging.
HEALTH_SHOW_DETAILS=never